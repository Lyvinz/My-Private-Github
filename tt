AzureDiagnostics
| where TimeGenerated > ago(90d)
| where Category == "NetworkSecurityGroupRuleCounter"
| where OperationName == "NetworkSecurityGroupCounters"
| extend Subscription = extract(
    @"/subscriptions/([^/]+)", 1, _ResourceId
)
| summarize Records = count(),
    NSGs = dcount(Resource)
    by Subscription
| order by Records desc



Resources
| where type =~ "microsoft.network/networksecuritygroups"
| summarize TotalNSGs = count()


Resources
| where type =~ "microsoft.network/networksecuritygroups"
| project NSG = name, ResourceGroup = resourceGroup, NSGId = id
| order by NSG asc


AzureDiagnostics
| where TimeGenerated > ago(90d)
| where Category == "NetworkSecurityGroupRuleCounter"
| where OperationName == "NetworkSecurityGroupCounters"
| summarize
    Records = count(),
    LastReported = max(TimeGenerated)
    by NSGId = tolower(_ResourceId)
| order by NSGId asc


