
AzureDiagnostics
| where TimeGenerated >= datetime(2026-08-01)
| where tostring(Resource) contains "api_mgmt"
    or tostring(_ResourceId) contains "api_mgmt"
| summarize
    Records = count(),
    LastReported = max(TimeGenerated)
    by Resource, Category, _ResourceId
| order by Records desc

